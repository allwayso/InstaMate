.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# 本机凭据；示例配置应随源码提交
.env*
!.env.example
!.env.*.example
*.pem
*.p12
*.pfx

# 各语言的本地依赖、缓存和日志
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
*.tsbuildinfo

.pdfbuild/raw.md
.pdfbuild/raw.html
.pdfbuild/proposal.html
.pdfbuild/*.pdf
.pdfbuild/*.png
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.pdfbuild/t*.html

# VRM 资产：体积大 + 有许可约束，用 tools/fetch-assets.sh 拉取，不进仓库
*.vrm

# 第三方模型资产（FBX/GLB）：体积大 + 许可不明，不进仓库
*.fbx
*.glb
*.usdz

# Tripo 导出包（队友给的生成资产，本地分析用）
tripo_asset_*/

# MediaPipe 的 wasm/模型（约 38 MB）：由 npm 包派生，用 node tools/sync-mediapipe.mjs 生成
web/public/vendor/

# G2 录制的原始关键点：单段可能 5–10 MB，体积不适合入库。
# 动作本体（web/public/clips/<id>.json，约 100 KB）仍然入库，它是团队共享资产。
# 代价：新克隆后动作库页面的「下载原始关键点」不可用，页面上会标注「仅本机」。
data/mocap/
data/states/
data/avatar-jobs/

# 联网调研的原始结果，与实现无关
.firecrawl/

# 依赖与构建产物（web/.gitignore 已覆盖 web/ 内，这里是根目录安全网）
node_modules/
.next/

# G0 本地证据（截图等），不入库
.g0/

# Tripo 管线产物（模型/贴图/中间图，体积大且可重新生成）
tripo/output/
tripo/.upload_probe.json

# Tripo API 凭据与 Python 缓存（★ 密钥绝不能入库）
tripo/.env
tripo/__pycache__/
