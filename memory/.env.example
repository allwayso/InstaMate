OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=
# ★ 模型选择（实测数据，不是偏好）：temperature=0、同一句「你好呀」、
#   干净会话 / 被「（右手挥手）」这类括号动作污染过的会话：
#
#     qwen-plus       ✅ 1.7s  /  ❌ 0.5s 无      ← auto 模式会被污染带跑
#     qwen-flash      ❌        /  ❌
#     qwen3.5-plus    ✅ 41.2s  /  ✅ 30.9s       ← 可靠但慢得离谱
#     qwen3.7-flash   ✅ 5.1s   /  ❌ 4.2s 无
#     qwen3.7-max     ✅ 24.3s  /  ✅ 27.7s
#     qwen3.8-max     ✅ 6.1s   /  ❌ 2.9s 无
#
#   强制 tool_choice=required 之后：qwen-plus 0.7s 且仍能自己选对状态。
#
#   ⇒ 选「快 + 支持强制 tool_choice」的模型。思考型模型（qwen3.5-plus、
#     qwen3.8-max 这类）两者都不行：慢，而且直接拒绝 required：
#       "tool_choice does not support being set to required in thinking mode"
#     而 required 正是让“触发词命中的动作可靠发生”的手段。
#     代码里对这种报错有降级（退回 auto），但降级意味着动作可能不发生。
MODEL_NAME=qwen-plus
SYSTEM_PROMPT=你是影伴，请结合当前会话的历史对话回答用户。
MEMORY_READ_DIR=./memory_data
MEMORY_WRITE_DIR=./memory_data
PROFILE_DATA_DIR=./profile_data
ALLOWED_ORIGINS=http://localhost:3000
