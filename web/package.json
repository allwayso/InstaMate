{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run sync:mediapipe",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "npm run sync:mediapipe",
    "build": "next build",
    "build:showcase-offline": "node offline/build-showcase.mjs",
    "prestart": "npm run sync:mediapipe",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "validate:clips": "node ../tools/validate-clip.mjs",
    "validate:fixtures": "node ../tools/validate-clip.mjs --fixtures ../tests/fixtures",
    "inspect:vrm": "node ../tools/inspect-vrm.mjs public/avatars/sample.vrm",
    "test:clip": "node --test --test-reporter=spec ../tests/clip-player.test.mjs",
    "test:mocap": "node --test --test-reporter=spec ../tests/mocap-retarget.test.mjs ../tests/mocap-clipbuilder.test.mjs",
    "test": "node --test \"../tests/*.test.mjs\"",
    "gen:clips": "node ../tools/gen-clips.mjs",
    "sync:mediapipe": "node ../tools/sync-mediapipe.mjs",
    "validate:all": "node ../tools/validate-clip.mjs --all public/clips",
    "verify:pipeline": "node ../tools/verify-mocap-pipeline.mjs"
  },
  "dependencies": {
    "@mediapipe/holistic": "0.5.1675471629",
    "@pixiv/three-vrm": "3.5.5",
    "@types/ws": "^8.18.1",
    "kalidokit": "1.1.5",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "esbuild": "^0.28.2",
    "typescript": "5.9.3"
  },
  "type": "module"
}
