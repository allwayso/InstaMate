# Qwen Audio ASR and TTS; only the server reads this key.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_WS_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_TTS_VOICE=longanlingxin

# Python session-memory service.
MEMORY_API_URL=http://127.0.0.1:8000

# Photo → Alibaba Cloud Qwen/Wanx anime reference → optional Tripo rigged GLB → local VRM.
# The image API key can also be saved from the Create Character page.
# Tripo is used only for the optional 3D phase; alternatively place its key in tripo/.env.
TRIPO_API_KEY=
# Optional. Also editable in the Create Character page.
# TRIPO_BASE_URL=https://api.tripo3d.com/v2/openapi
# TRIPO_PYTHON=/absolute/path/to/python-with-requests-and-python-dotenv
# AVATAR_JOBS_DIR=/absolute/path/to/avatar-jobs

# Optional: persistent local state library directory.
# STATES_DIR=/absolute/path/to/states
